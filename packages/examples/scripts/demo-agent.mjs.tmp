/**
 * Example — generate a richer demo .replay.jsonl recording.
 *
 * Multi-turn agent with a nested tool span, an error + recovery, and
 * realistic metric events. No real LLM is contacted. Produces a recording
 * that exercises every viewer feature: timeline, spans, conversation,
 * inspector, stats, filters.
 *
 *   pnpm build && node packages/examples/scripts/demo-agent.js
 *   → packages/examples/demo.replay.jsonl
 */
import { Recorder } from "../../core/dist/index.js";
import { writeFileSync, mkdirSync } from "node:fs";
import { dirname } from "node:path";

const OUT = process.env.AGENT_REPLAY_OUT ?? "packages/examples/demo.replay.jsonl";

async function main(): Promise<void> {
  const rec = new Recorder({ name: "demo-agent" });

  // Turn 1 — a simple listing request.
  rec.message("user", "What files are in the src directory?");
  rec.thought("thinking", "User wants a directory listing — I'll call list_files.");
  await sleep(60);

  const modelSpan = rec.span("model.openai.chat");
  rec.prompt("openai", {
    model: "gpt-4o-mini",
    messages: [{ role: "user", content: "What files are in the src directory?" }],
  });
  await sleep(40);
  for (const t of ["I'll", " check", " `src`", " for", " you", "."]) {
    rec.delta(t);
    await sleep(20);
  }
  rec.response("openai", { model: "gpt-4o-mini", content: "I'll check `src` for you." });
  rec.metric("tokens", 88);
  rec.metric("cost", 0.0002);
  modelSpan.end();

  const toolSpan = rec.span("tool:list_files");
  rec.toolCall("list_files", { path: "./src" });
  await sleep(90);
  rec.toolResult("list_files", { files: ["main.ts", "utils.ts", "config.json"] });
  toolSpan.end();
  rec.message("assistant", "The `src` directory contains: main.ts, utils.ts, and config.json.");

  // Turn 2 — an action that errors, then recovers.
  rec.message("user", "Delete config.json.");
  rec.thought("thinking", "Deletion requested — call delete_file, but it will fail (permissions).");
  const failSpan = rec.span("tool:delete_file");
  rec.toolCall("delete_file", { path: "./src/config.json" });
  await sleep(70);
  rec.error(new Error("EACCES: permission denied, unlink './src/config.json'"), { spanId: failSpan.id });
  rec.toolResult("delete_file", { ok: false, error: "permission denied" });
  failSpan.end();
  rec.message("assistant", "I couldn't delete config.json — permission denied. Want me to try with sudo?");

  rec.metric("tokens", 24);
  rec.metric("cost", 0.0001);

  const events = rec.end();
  mkdirSync(dirname(OUT), { recursive: true });
  const lines = events.map((e) => JSON.stringify(e)).join("\n") + "\n";
  writeFileSync(OUT, lines);
  console.error(`◆ recorded ${events.length} events → ${OUT}`);
}

function sleep(ms: number): Promise<void> {
  return new Promise((r) => setTimeout(r, ms));
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
